# 服务
PORT=3000
PUBLIC_BASE_URL=http://localhost:3000
NODE_ENV=development

# 数据库 / 缓存
DATABASE_URL=postgresql://fitbest:fitbest@localhost:5432/fitbest?schema=public
REDIS_URL=redis://localhost:6379

# JWT
JWT_ACCESS_SECRET=change-me-access
JWT_REFRESH_SECRET=change-me-refresh
JWT_ADMIN_SECRET=change-me-admin
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# 验证码策略
AUTH_CODE_TTL=300
AUTH_CODE_COOLDOWN=60
AUTH_CODE_DAILY_LIMIT=10
AUTH_DEV_RETURN_CODE=true

# 二维码签名密钥（生产必须替换）
QR_SIGN_SECRET=change-me-qr

# 阿里云短信
ALIYUN_ACCESS_KEY_ID=
ALIYUN_ACCESS_KEY_SECRET=
ALIYUN_SMS_SIGN_NAME=FITBEST
ALIYUN_SMS_TEMPLATE_LOGIN=SMS_000000001
ALIYUN_SMS_TEMPLATE_BIND=SMS_000000002

# 阿里云邮件推送（DirectMail）
ALIYUN_DM_ACCOUNT=no-reply@example.com
ALIYUN_DM_ALIAS=FITBEST
ALIYUN_DM_REGION=cn-hangzhou

# 微信开放平台/移动应用
WECHAT_APP_ID=
WECHAT_APP_SECRET=
WECHAT_WEB_APP_ID=
WECHAT_WEB_APP_SECRET=

# AI 教练（OpenAI 兼容接口；留空则使用内置规则回复）
LLM_API_BASE=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_TIMEOUT_MS=20000
# Legacy Prisma seed only. Supply both values before running npm run seed.
SEED_ADMIN_PHONE=
SEED_ADMIN_PASSWORD=
