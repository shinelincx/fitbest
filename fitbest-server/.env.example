# FITBEST 统一服务 · 完整环境变量模板
# 使用：复制到 /opt/fitbest/server/.env（生产，600 权限）或本地开发复制为 .env
# 注意：所有键与 application.yml 一一对应；留空的键走安全默认值（如短信未配置时返回可读错误）

# ===== 服务 =====
# 对外端口（nginx 反代目标）
HOST_PORT=9090
# production 时微信未配置将拒绝登录（而非 dev 模拟）
NODE_ENV=production
# 公开访问地址（分享短链前缀，必须带 https:// 域名）
PUBLIC_BASE_URL=https://cloud.thinkfiter.com

# ===== 数据库（compose 内置 PostgreSQL；密码务必修改） =====
POSTGRES_PASSWORD=change-me-strong-password

# ===== 静态站根目录（7 个站点产物） =====
FITBEST_WEB_DIR=/opt/fitbest/web

# ===== CORS（逗号分隔白名单） =====
CORS_ALLOWED_ORIGINS=https://cloud.thinkfiter.com

# ===== JWT 密钥（openssl rand -hex 32 生成，三个必须不同） =====
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ADMIN_SECRET=
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# ===== 验证码策略 =====
AUTH_CODE_TTL=300
AUTH_CODE_COOLDOWN=60
AUTH_CODE_DAILY_LIMIT=10
# true = 回传验证码给客户端。生产必须 false（白名单号码除外，见下）
AUTH_DEV_RETURN_CODE=false
# 测试号码白名单（逗号分隔）：RETURN_CODE=true 时仅这些号码回传 devCode，
# 其余号码走真实短信。配置完真实短信后建议保持 RETURN_CODE=false + 白名单留空
AUTH_DEV_PHONE_ALLOWLIST=

# ===== 器械二维码签名（openssl rand -hex 32） =====
QR_SIGN_SECRET=

# ===== 阿里云短信（dysmsapi） =====
# RAM 子账号 AccessKey（建议仅授权 AliyunDysmsFullAccess）
ALIYUN_ACCESS_KEY_ID=
ALIYUN_ACCESS_KEY_SECRET=
# 已审核通过的短信签名
ALIYUN_SMS_SIGN_NAME=FITBEST
# 验证码模板 CODE（模板变量必须为 ${code}）；登录/绑定可共用同一模板
ALIYUN_SMS_TEMPLATE_LOGIN=
ALIYUN_SMS_TEMPLATE_BIND=

# ===== 邮件（通用 SMTP：腾讯企业邮 / QQ / 网易 / 自建等） =====
# SMTP 服务器地址，常见：smtp.exmail.qq.com（腾讯企业邮）/ smtp.qq.com / smtp.163.com
MAIL_SMTP_HOST=
# 端口：465（SSL，默认）/ 587（STARTTLS）
MAIL_SMTP_PORT=465
# true = 465 隐式 SSL；false = 587 STARTTLS
MAIL_SMTP_SSL=true
# SMTP 登录账号（QQ/网易邮箱此处填授权码对应的账号）
MAIL_SMTP_USERNAME=
# SMTP 密码或授权码（QQ 邮箱=授权码；腾讯企业邮=邮箱密码）
MAIL_SMTP_PASSWORD=
# 发件人地址（留空则用 MAIL_SMTP_USERNAME）
MAIL_FROM=
# 发件人显示名
MAIL_FROM_NAME=FITBEST

# ===== 微信开放平台（可选，Web/APP 登录） =====
WECHAT_APP_ID=
WECHAT_APP_SECRET=
WECHAT_WEB_APP_ID=
WECHAT_WEB_APP_SECRET=

# ===== AI 教练（OpenAI 兼容接口，可选；留空走内置规则引擎） =====
LLM_API_BASE=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_TIMEOUT_MS=20000
